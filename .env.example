# Hierarchical Context Tree Engine - Environment Configuration
# Copy this file to .env and update the values

# Required: HMAC-SHA256 audit trail signing key (minimum 16 characters)
AUDIT_SECRET_KEY=your-secure-random-key-here-min-16-chars

# Optional: LLM provider (mock, ollama, claude, openai)
MODEL_PROVIDER=mock
\n# Optional: allow protected GET /api/audit/logs access via X-Audit-Read-Key\n# Without this setting, the endpoint rejects all requests.\n# AUDIT_LOG_READ_KEY=separate-random-secret-for-audit-reads\n