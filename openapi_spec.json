{
  "openapi": "3.1.0",
  "info": {
    "title": "Hierarchical Context Tree Engine API",
    "description": "Deterministic threshold-based task evaluation API with in-memory HMAC audit entries.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Process is available"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory JSON counters",
        "responses": {
          "200": {
            "description": "JSON process-level metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with in-memory HMAC audit hash"
          },
          "422": {
            "description": "Validation or sensitive-identifier rejection"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Mock supervisory response (no external LLM)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read in-memory audit metadata with a configured secret header",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "403": {
            "description": "Audit log access is disabled or header key is invalid"
          }
        },
        "security": [
          {
            "auditReadKey": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "auditReadKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Audit-Read-Key",
        "description": "Matches AUDIT_LOG_READ_KEY configured on server; endpoint disabled if unset."
      }
    }
  }
}
